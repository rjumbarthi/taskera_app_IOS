# Cloudflare Pages response headers for the Kaal web app.
# This file lives in web/ so Flutter copies it into build/web/ on every build,
# and Cloudflare Pages serves it from the site root.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# ── OPTIONAL: cross-origin isolation ──────────────────────────────────────────
# Uncomment BOTH lines below to upgrade the local SQLite (Drift WASM) database
# from the IndexedDB fallback to OPFS-backed storage. Caveat: COEP require-corp
# can block cross-origin resources that don't send CORP headers — test Supabase
# sign-in + data sync after enabling. Leave commented for the safe default.
# /*
#   Cross-Origin-Opener-Policy: same-origin
#   Cross-Origin-Embedder-Policy: require-corp
