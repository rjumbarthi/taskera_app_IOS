<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Kaal</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Port443 LLC. All rights reserved.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kaal uses the microphone for voice capture of notes and tasks.</string>
	<!-- Required by AdMob / Google Mobile Ads (IDFA + App Tracking Transparency).
	     Apple rejects ad-supported apps that link ATT without this string. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Allow tracking so Kaal can show you more relevant ads. Kaal works fully either way, and your data is never sold.</string>
	<!-- Export-compliance: Kaal only uses standard, exempt encryption (HTTPS/TLS).
	     Declaring this here skips the App Store Connect encryption question on every
	     upload. Set to true only if you add non-exempt/custom cryptography. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- AdMob application id. Required by the Google Mobile Ads SDK or the app
	     crashes on launch. Real Kaal iOS AdMob app id. Ad units still use
	     Google's test unit ids (AdsConfig.useTestAds) until the 4 real ad
	     unit ids + Android app id are ready. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-9013964076288950~7410101558</string>
	<!-- Native Google Sign-In (google_sign_in package) — required for
	     GoogleSignIn() to work on iOS. Matches AppConfig.googleClientIdIos. -->
	<key>GIDClientID</key>
	<string>657874499735-v5ocrfin2as18hgu3lv3ba726vdggsmp.apps.googleusercontent.com</string>
	<!-- SKAdNetwork ad-attribution ids. cstr6suwn9 is Google/AdMob's own network.
	     Add other ad networks' ids here if you enable mediation. Missing this loses
	     ad attribution but is not a rejection blocker. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>CFBundleName</key>
	<string>kaal_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Deep-link scheme so Supabase OAuth (Google/Microsoft) returns to the app.
	     Matches AppConfig.deepLinkScheme = 'io.supabase.kaalapp'. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>io.supabase.kaalapp</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>io.supabase.kaalapp</string>
			</array>
		</dict>
		<!-- Reversed GIDClientID — required callback scheme for native Google
		     Sign-In on iOS. Matches AppConfig.googleClientIdIos. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.657874499735-v5ocrfin2as18hgu3lv3ba726vdggsmp</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
